---
import MainLayout from "../layouts/main.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime, getSlug, getSortedPosts } from "../utils/posts";

const recentPosts = (await getSortedPosts()).slice(0, 3);
---

<MainLayout
  title="idárcio oliveira — software engineer"
  description="Projects, work history and notes from Idárcio Oliveira, a software engineer based in Angola."
  ogImage="/og-default.jpg"
>
  <Hero
    title="hi, i'm idárcio oliveira."
    subtitle="I'm a software engineer based in Angola. I build web and mobile apps."
    primaryCta={{ href: "/about", label: "more about me" }}
  />

  {recentPosts.length > 0 && (
    <Section tight>
      <ul>
        {recentPosts.map((post) => {
          const slug = getSlug(post.id);
          const { minutes } = getReadingTime(post.body ?? "");
          return (
            <PostCard
              slug={slug}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              minutes={minutes}
              heroImage={post.data.heroImage}
            />
          );
        })}
      </ul>
      <a href="/posts" class="content-footer__cta">All Posts →</a>
    </Section>
  )}
</MainLayout>
