---
import MainLayout from "../layouts/main.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import PostCard from "../components/PostCard.astro";
import { defaultLang, postsPath } from "../i18n";
import { getListedPosts, getReadingTime, getSlug } from "../utils/posts";
import { schemaIds } from "../utils/schema";

const recentPosts = (await getListedPosts(defaultLang)).slice(0, 3);
const ids = schemaIds(Astro.site!);
const schema = {
  "@type": "WebPage",
  "@id": `${new URL("/", Astro.site!)}#webpage`,
  url: new URL("/", Astro.site!).toString(),
  name: "Idárcio Oliveira, Software Engineer",
  isPartOf: { "@id": ids.website },
  about: { "@id": ids.person },
  mainEntity: { "@id": ids.person },
};
---

<MainLayout
  title="Idárcio Oliveira — Software Engineer in Angola"
  description="Idárcio Oliveira is a software engineer and tech lead based in Angola. Backend and mobile apps with TypeScript, NestJS, PostgreSQL and React Native. Posts, work history and contact."
  schema={schema}
  ogImage="/og-default.jpg"
>
  <Hero
    title="hi, i'm idárcio oliveira."
    subtitle="I'm a software engineer based in Angola. I build web and mobile apps."
    primaryCta={{ href: "/about", label: "more about me" }}
  />

  {recentPosts.length > 0 && (
    <Section tight>
      <ul>
        {recentPosts.map((post) => {
          const slug = getSlug(post.id);
          const { lang } = post.data;
          const { minutes } = getReadingTime(post.body ?? "", lang);
          return (
            <PostCard
              slug={slug}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              minutes={minutes}
              heroImage={post.data.heroImage}
              lang={lang}
            />
          );
        })}
      </ul>
      <a href={postsPath(defaultLang)} class="content-footer__cta">All Posts →</a>
    </Section>
  )}
</MainLayout>
