---
import MainLayout from "../layouts/main.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime, getSortedPosts } from "../utils/posts";

const recentPosts = (await getSortedPosts()).slice(0, 3);
---

<MainLayout
  title="idárcio oliveira — software engineer"
  description="portfolio of idárcio oliveira with projects, experience and professional moments."
  ogImage="/profile-image.jpeg"
>
  <Hero
    title="software engineer."
    subtitle="hi, i'm idárcio oliveira. a passionate software engineer and front end developer based in angola."
    primaryCta={{ href: "/projects", label: "see my works" }}
  />

  {recentPosts.length > 0 && (
    <Section tight>
      <ul>
        {recentPosts.map((post) => {
          const slug = post.id.replace(/\.(md|mdx)$/, "");
          const { minutes } = getReadingTime(post.body ?? "");
          return (
            <PostCard
              slug={slug}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              minutes={minutes}
              heroImage={post.data.heroImage}
            />
          );
        })}
      </ul>
      <a href="/posts" class="content-footer__cta">All Posts →</a>
    </Section>
  )}
</MainLayout>
