---
import MainLayout from "../../layouts/main.astro";
import Section from "../../components/Section.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { blog, site } from "../../config";
import { getReadingTime, getSortedPosts, getUniqueTags } from "../../utils/posts";
import type { Page } from "astro";

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: blog.perPage });
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const tags = isFirstPage ? await getUniqueTags() : [];
const featured = isFirstPage
  ? (await getSortedPosts()).filter((p) => p.data.featured)
  : [];
const pageTitle =
  page.currentPage === 1
    ? `Posts — ${site.title}`
    : `Posts (página ${page.currentPage}) — ${site.title}`;
---

<MainLayout
  title={pageTitle}
  description="Anotações, aprendizados e ideias sobre engenharia de software, frontend e produto."
  ogImage={site.ogImage}
  noindex={page.currentPage > 1 ? false : false}
>
  <Section
    eyebrow="Posts"
    title="Notas rápidas e aprendizados"
    description="Rascunhos e aprendizados sobre frontend, produto e engenharia em projetos reais."
  >
    <h1 class="sr-only">Posts — notas sobre engenharia de software</h1>
    <Breadcrumb trail={[{ label: page.currentPage > 1 ? `Posts (página ${page.currentPage})` : "Posts" }]} />

    {isFirstPage && featured.length > 0 && (
      <div class="mb-10">
        <h2 class="mb-4 text-2xl font-bold tracking-tight">Destaques</h2>
        <div class="space-y-4">
          {featured.map((post) => {
            const slug = post.id.replace(/\.(md|mdx)$/, "");
            const { minutes } = getReadingTime(post.body ?? "");
            return (
              <PostCard
                slug={slug}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                updatedDate={post.data.updatedDate}
                tags={post.data.tags}
                minutes={minutes}
              />
            );
          })}
        </div>
      </div>
    )}

    <div class="space-y-4">
      {page.data.map((post: any) => {
        const slug = post.id.replace(/\.(md|mdx)$/, "");
        const { minutes } = getReadingTime(post.body ?? "");
        return (
          <PostCard
            slug={slug}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            tags={post.data.tags}
            minutes={minutes}
          />
        );
      })}
    </div>

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />

    {isFirstPage && tags.length > 0 && (
      <div class="mt-12">
        <h2 class="mb-4 text-2xl font-bold tracking-tight">Explorar por tag</h2>
        <ul class="flex flex-wrap gap-2">
          {tags.map((t) => (
            <li>
              <a href={`/tags/${t.tag}/`} class="badge transition-colors hover:border-(--accent) hover:text-(--accent)">
                #{t.tagName} ({t.count})
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </Section>
</MainLayout>
