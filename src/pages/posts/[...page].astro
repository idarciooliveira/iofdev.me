---
import MainLayout from "../../layouts/main.astro";
import Section from "../../components/Section.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { blog, site } from "../../config";
import { getReadingTime, getSortedPosts } from "../../utils/posts";
import type { Page } from "astro";

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: blog.perPage });
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const pageTitle =
  page.currentPage === 1
    ? `Posts — ${site.title}`
    : `Posts (página ${page.currentPage}) — ${site.title}`;

// Archives-style grouping (AstroPaper archives pattern):
// year (desc) → month (desc) → posts (newest first).
type Post = (typeof page.data)[number];
const postsByYear = new Map<number, Post[]>();
for (const post of page.data as Post[]) {
  const year = new Date(post.data.pubDate).getFullYear();
  const group = postsByYear.get(year) ?? [];
  group.push(post);
  postsByYear.set(year, group);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);

const monthFormatter = new Intl.DateTimeFormat("pt", { month: "long" });
const monthName = (monthIndex: number) => {
  const name = monthFormatter.format(new Date(2000, monthIndex, 1));
  return name.charAt(0).toUpperCase() + name.slice(1);
};
---

<MainLayout
  title={pageTitle}
  description="Anotações, aprendizados e ideias sobre engenharia de software, frontend e produto."
  ogImage={site.ogImage}
  noindex={page.currentPage > 1 ? false : false}
>
  <Section
    eyebrow="Posts"
    title="Notas rápidas e aprendizados"
    description="Rascunhos e aprendizados sobre frontend, produto e engenharia em projetos reais."
  >
    <h1 class="sr-only">Posts — notas sobre engenharia de software</h1>

    {years.map((year) => {
      const yearPosts = postsByYear.get(year)!;
      const postsByMonth = new Map<number, Post[]>();
      for (const post of yearPosts) {
        const month = new Date(post.data.pubDate).getMonth();
        const group = postsByMonth.get(month) ?? [];
        group.push(post);
        postsByMonth.set(month, group);
      }
      const months = [...postsByMonth.keys()].sort((a, b) => b - a);
      return (
        <section aria-label={`Posts de ${year}`} class="mb-10 last:mb-0">
          <span class="text-2xl font-bold tracking-tight">{year}</span>
          <sup class="ml-1 text-sm text-(--text-soft)">{yearPosts.length}</sup>
          <div aria-hidden="true" class="mt-2 h-px bg-(--accent)" />
          {months.map((month) => {
            const monthPosts = postsByMonth.get(month)!;
            return (
              <div class="flex flex-col sm:flex-row">
                <div class="mt-6 min-w-36 text-lg sm:my-6">
                  <span class="font-bold">{monthName(month)}</span>
                  <sup class="ml-1 text-xs text-(--text-soft)">
                    {monthPosts.length}
                  </sup>
                </div>
                <ul>
                  {monthPosts.map((post) => {
                    const slug = post.id.replace(/\.(md|mdx)$/, "");
                    const { minutes } = getReadingTime(post.body ?? "");
                    return (
                      <PostCard
                        slug={slug}
                        title={post.data.title}
                        description={post.data.description}
                        pubDate={post.data.pubDate}
                        minutes={minutes}
                        heroImage={post.data.heroImage}
                      />
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </section>
      );
    })}

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
  </Section>
</MainLayout>
