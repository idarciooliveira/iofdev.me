---
import PostsIndex from "../../views/PostsIndex.astro";
import { postsListPaths } from "../../utils/routes";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return postsListPaths("pt", paginate);
}

const { page } = Astro.props;
---

<PostsIndex lang="pt" page={page} />
