---
import MainLayout from "../../layouts/main.astro";
import ShareLinks from "../../components/ShareLinks.astro";
import { site } from "../../config";
import { formatDate, getReadingTime, getSortedPosts, slugify } from "../../utils/posts";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: {
      post,
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, heroImage, canonicalURL, author } =
  post.data;

const rawHero = heroImage;
const pageOgImage = rawHero ?? site.ogImage;
const pageUrl = new URL(`/posts/${post.id.replace(/\.(md|mdx)$/, "")}/`, Astro.site ?? site.url).toString();
const { minutes, text: readingText } = getReadingTime(post.body ?? "");

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: new URL(pageOgImage, Astro.site ?? site.url).toString(),
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: [{ "@type": "Person", name: author, url: site.profile }],
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
};
---

<MainLayout
  title={`${title} | ${site.title}`}
  description={description}
  ogImage={pageOgImage}
  canonicalURL={canonicalURL}
  ogType="article"
  pubDatetime={pubDate}
  modDatetime={updatedDate}
  schema={schema}
>
  <div class="page-section" id="top">
    <div class="site-shell">
      <header>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-(--text-soft)">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && updatedDate > pubDate && (
            <span>· Atualizado em {formatDate(updatedDate)}</span>
          )}
          <span>· {readingText}</span>
        </div>
      </header>

      <article class="app-prose mt-8">
        <Content />
      </article>

      <footer class="mt-12">
        {tags.length > 0 && (
          <ul class="post-footer__tags" aria-label="Tags">
            {tags.map((tag: string) => (
              <li>
                <a href={`/tags/${slugify(tag)}/`} class="post-footer__tag">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )}

        <ShareLinks title={title} url={pageUrl} />

        <hr class="post-footer__dotted" />

        <nav aria-label="Posts adjacentes" class="flex items-start justify-between gap-4" data-pagefind-ignore>
          {prev ? (
            <a href={`/posts/${prev.id.replace(/\.(md|mdx)$/, "")}/`} class="post-footer__next !text-left">
              <span class="post-footer__next-kicker !justify-start">← Previous Post</span>
              <p class="post-footer__next-title">{prev.data.title}</p>
            </a>
          ) : <span />}
          {next ? (
            <a href={`/posts/${next.id.replace(/\.(md|mdx)$/, "")}/`} class="post-footer__next ml-auto">
              <span class="post-footer__next-kicker">Next Post
                <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </span>
              <p class="post-footer__next-title">{next.data.title}</p>
            </a>
          ) : <span />}
        </nav>
      </footer>
    </div>
  </div>
</MainLayout>
