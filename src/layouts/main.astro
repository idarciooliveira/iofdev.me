---
import "@fontsource/google-sans-code/300.css";
import "@fontsource/google-sans-code/300-italic.css";
import "@fontsource/google-sans-code/400.css";
import "@fontsource/google-sans-code/400-italic.css";
import "@fontsource/google-sans-code/500.css";
import "@fontsource/google-sans-code/500-italic.css";
import "@fontsource/google-sans-code/600.css";
import "@fontsource/google-sans-code/600-italic.css";
import "@fontsource/google-sans-code/700.css";
import "@fontsource/google-sans-code/700-italic.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import SocialIconDock from "../components/SocialIconDock.astro";
import { site } from "../config";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image. Falls back to site.ogImage. */
  ogImage?: string;
  /** Absolute canonical URL override (for cross-posts). Defaults to current path. */
  canonicalURL?: string;
  canonical?: string;
  ogType?: "website" | "article";
  pubDatetime?: string | Date;
  modDatetime?: string | Date;
  /** Extra JSON-LD object to inject (e.g. BlogPosting). */
  schema?: Record<string, unknown>;
  noindex?: boolean;
  content?: {
    title?: string;
    description?: string;
    ogImage?: string;
    canonical?: string;
    canonicalURL?: string;
  };
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  canonical,
  ogType = "website",
  pubDatetime,
  modDatetime,
  schema,
  noindex = false,
  content,
} = Astro.props;

const pageTitle = title ?? content?.title ?? `${site.author} — Portfólio`;
const pageDescription = description ?? content?.description ?? site.description;

// Canonical: explicit override wins, otherwise current path on production site.
const siteUrl = Astro.site ?? new URL(site.url);
const rawCanonical = canonicalURL ?? canonical ?? content?.canonicalURL ?? content?.canonical;
const canonicalHref = rawCanonical
  ? new URL(rawCanonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

// OG image: must be absolute PNG/JPG (no SVG — unsupported by FB/X).
// Per-page ogImage > content ogImage > site default.
const rawOgImage = ogImage ?? content?.ogImage ?? site.ogImage;
const ogImageHref = new URL(rawOgImage, siteUrl).toString();
const isArticle = ogType === "article";
const pubISO =
  pubDatetime instanceof Date
    ? pubDatetime.toISOString()
    : pubDatetime
      ? new Date(pubDatetime).toISOString()
      : undefined;
const modISO =
  modDatetime instanceof Date
    ? modDatetime.toISOString()
    : modDatetime
      ? new Date(modDatetime).toISOString()
      : undefined;

const defaultSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.title,
  url: siteUrl.toString(),
  author: { "@type": "Person", name: site.author, url: site.profile },
};
---

<html lang={site.lang} class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <ClientRouter />
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const savedTheme = localStorage.getItem(storageKey);
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : systemPrefersDark
              ? "dark"
              : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Font: Google Sans Code (same family as AstroPaper, via Fontsource local bundle) -->
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0f1115" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL("rss.xml", siteUrl).toString()}
    />
    <meta property="og:locale" content="pt_AO" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageHref} />
    {isArticle && pubISO && <meta property="article:published_time" content={pubISO} />}
    {isArticle && modISO && <meta property="article:modified_time" content={modISO} />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema ?? defaultSchema)}
    />
    <slot name="head" />
  </head>
  <body class="font-app flex min-h-svh flex-col">
    <Nav currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell">
        <hr class="site-footer__rule" />
        <div class="site-footer__inner">
          <p class="site-footer__license">
            Steal this post → CC BY 4.0 · Code MIT
          </p>
          <SocialIconDock />
        </div>
      </div>
    </footer>
  </body>
</html>
