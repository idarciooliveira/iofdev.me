---
import "@fontsource/google-sans-code/300.css";
import "@fontsource/google-sans-code/300-italic.css";
import "@fontsource/google-sans-code/400.css";
import "@fontsource/google-sans-code/400-italic.css";
import "@fontsource/google-sans-code/500.css";
import "@fontsource/google-sans-code/500-italic.css";
import "@fontsource/google-sans-code/600.css";
import "@fontsource/google-sans-code/600-italic.css";
import "@fontsource/google-sans-code/700.css";
import "@fontsource/google-sans-code/700-italic.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import Nav from "../components/Nav.astro";
import SocialIconDock from "../components/SocialIconDock.astro";
import { person, site } from "../config";
import { personSchema, websiteSchema } from "../utils/schema";
import { defaultLang, langInfo, rssPath, type Lang } from "../i18n";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image. Falls back to site.ogImage. */
  ogImage?: string;
  /** Absolute canonical URL override (for cross-posts). Defaults to current path. */
  canonicalURL?: string;
  canonical?: string;
  ogType?: "website" | "article";
  pubDatetime?: string | Date;
  modDatetime?: string | Date;
  /** Extra JSON-LD nodes for this page (e.g. BlogPosting), merged into the site graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Language of the page content. Pages that omit it are English, and the nav falls back to the default language. */
  lang?: Lang;
  /** Other-language versions of this page, used for hreflang and the nav language switch. */
  alternates?: { lang: Lang; href: string }[];
  /** Where the nav language switch points, when the page has a counterpart. */
  switchHref?: string;
  content?: {
    title?: string;
    description?: string;
    ogImage?: string;
    canonical?: string;
    canonicalURL?: string;
  };
}

const {
  title,
  description,
  ogImage,
  canonicalURL,
  canonical,
  ogType = "website",
  pubDatetime,
  modDatetime,
  schema,
  noindex = false,
  lang,
  alternates = [],
  switchHref,
  content,
} = Astro.props;

const pageTitle = title ?? content?.title ?? `${site.author} — Software Engineer`;
const pageDescription = description ?? content?.description ?? site.description;

// Canonical: explicit override wins, otherwise current path on production site.
const siteUrl = Astro.site ?? new URL(site.url);
const rawCanonical = canonicalURL ?? canonical ?? content?.canonicalURL ?? content?.canonical;
const canonicalHref = rawCanonical
  ? new URL(rawCanonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

// OG image: must be absolute PNG/JPG (no SVG — unsupported by FB/X).
// Per-page ogImage > content ogImage > site default.
const rawOgImage = ogImage ?? content?.ogImage ?? site.ogImage;
const ogImageHref = new URL(rawOgImage, siteUrl).toString();
const ogImageType = /\.png$/i.test(rawOgImage)
  ? "image/png"
  : /\.webp$/i.test(rawOgImage)
    ? "image/webp"
    : "image/jpeg";
const isArticle = ogType === "article";
const pubISO =
  pubDatetime instanceof Date
    ? pubDatetime.toISOString()
    : pubDatetime
      ? new Date(pubDatetime).toISOString()
      : undefined;
const modISO =
  modDatetime instanceof Date
    ? modDatetime.toISOString()
    : modDatetime
      ? new Date(modDatetime).toISOString()
      : undefined;

// Every page carries the WebSite and Person nodes, so search engines tie
// the name, the domain and the social profiles together.
const pageSchemas = (Array.isArray(schema) ? schema : schema ? [schema] : []).map(
  ({ "@context": _ctx, ...node }) => node,
);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [websiteSchema(siteUrl), personSchema(siteUrl), ...pageSchemas],
};
---

<html lang={lang ?? "en"} class="overflow-y-scroll scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const savedTheme = localStorage.getItem(storageKey);
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme =
          savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : systemPrefersDark
              ? "dark"
              : "light";
        document.documentElement.setAttribute("data-theme", theme);
        // Expose value so src/scripts/theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Font: Google Sans Code (same family as AstroPaper, via Fontsource local bundle) -->
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.author} />
    <meta name="google-site-verification" content="rNaoNoyiESHOb5rygv6wURtsVpQx01GO5dcvTO6h2_Y" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* Filled at runtime by src/scripts/theme.ts to match the current background colour */}
    <meta name="theme-color" content="" />
    <link rel="canonical" href={canonicalHref} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, siteUrl).toString()} />
    ))}
    {alternates.length > 0 && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL((alternates.find((alt) => alt.lang === defaultLang) ?? alternates[0]).href, siteUrl).toString()}
      />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {person.sameAs.map((href) => <link rel="me" href={href} />)}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssPath(lang ?? defaultLang), siteUrl).toString()}
    />
    <meta property="og:locale" content={langInfo[lang ?? "en"].ogLocale} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:alt" content={pageTitle} />
    {rawOgImage === site.ogImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:type" content={ogImageType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageHref} />
    {isArticle && pubISO && <meta property="article:published_time" content={pubISO} />}
    {isArticle && modISO && <meta property="article:modified_time" content={modISO} />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <slot name="head" />
    <Analytics />
  </head>
  <body class="font-app flex min-h-svh flex-col">
    <Nav currentPath={Astro.url.pathname} lang={lang ?? defaultLang} switchHref={switchHref} />
    <main class="flex-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-shell">
        <hr class="site-footer__rule" />
        <div class="site-footer__inner">
          <p class="site-footer__license">
            Steal this post → CC BY 4.0 · Code MIT
          </p>
          <SocialIconDock />
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
