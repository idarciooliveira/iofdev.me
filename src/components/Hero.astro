---
const {
  title = "creative designer & developer.",
  subtitle = "hi, i'm idárcio oliveira. a passionate software engineer and front end developer based in angola.",
  primaryCta = { href: "/projects", label: "see my works" },
  socials = [
    { href: "https://github.com/idarciooliveira", label: "GitHub" },
    { href: "https://www.linkedin.com/in/idarciooliveira", label: "LinkedIn" },
    { href: "mailto:idarciooliveira@gmail.com", label: "Email" },
  ],
  imageSrc = "/profile-image.jpeg",
  imageAlt = "portrait of idárcio oliveira",
} = Astro.props;

const words = String(title).split(" ");
---

<section class="hero">
  <div class="site-shell hero__grid">
    <div class="hero__copy">
      <h1 class="hero-title">
        {words.map((w, i) => (
          <span class="hero-title__word">{w}{i < words.length - 1 ? "\u00A0" : ""}</span>
        ))}
      </h1>
      <p class="hero-copy">
        {subtitle}
      </p>

      <a href={primaryCta.href} class="cta-minimal group">
        <span class="cta-minimal__circle" aria-hidden="true"></span>
        <span class="cta-minimal__label">{primaryCta.label}</span>
        <span class="cta-minimal__arrow" aria-hidden="true">→</span>
      </a>

      <div class="hero__socials">
        {
          socials.map((item, i) => (
            <>
              <a
                href={item.href}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  item.href.startsWith("http")
                    ? "noreferrer noopener"
                    : undefined
                }
                class="text-social"
              >
                {item.label}
              </a>
              {i < socials.length - 1 && (
                <span aria-hidden="true" class="hero__sep">
                  /
                </span>
              )}
            </>
          ))
        }
      </div>
    </div>

    <div class="hero__visual" aria-hidden="false">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="hero__photo"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
