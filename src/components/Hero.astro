---
import SocialIconDock from "./SocialIconDock.astro";

const {
  title = "Hi, I'm Idárcio.",
  subtitle = "AI-powered tools from Swift roots to web frontiers. Every commit lands on GitHub for you to fork & remix.",
  primaryCta = { href: "/projects", label: "see my works" },
  imageSrc = "/profile-image.jpeg",
  imageAlt = "portrait of idárcio oliveira",
} = Astro.props;

const words = String(title).split(" ");
---

<section class="hero">
  <div class="site-shell hero__grid">
    <div class="hero__copy">
      <h1 class="hero-title">
        {
          words.map((w, i) => (
            <span class="hero-title__word">
              {w}
              {i < words.length - 1 ? "\u00A0" : ""}
            </span>
          ))
        }
      </h1>
      <p class="hero-copy">
        {subtitle}
      </p>

      <a href={primaryCta.href} class="cta-minimal group">
        <span class="cta-minimal__circle" aria-hidden="true"></span>
        <span class="cta-minimal__label">{primaryCta.label}</span>
        <span class="cta-minimal__arrow" aria-hidden="true">→</span>
      </a>

      <div class="hero__socials">
        <SocialIconDock />
      </div>
    </div>

    <div class="hero__visual" aria-hidden="false">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="hero__photo"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
