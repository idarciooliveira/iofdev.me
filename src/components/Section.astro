---
const { eyebrow, title, description, tight = false, class: className = "" } = Astro.props;
const hasHeader = Boolean(eyebrow || title || description);
---

<section class:list={["page-section", tight && "page-section--tight", className]}>
  <div class="site-shell">
    {hasHeader && (
      <div class="mb-8 space-y-3 sm:mb-10">
        {eyebrow && <p class="badge">{eyebrow}</p>}
        {title && <h2 class="text-2xl font-semibold sm:text-3xl">{title}</h2>}
        {description && <p class="mt-2 max-w-3xl text-base text-(--text-soft)">{description}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
