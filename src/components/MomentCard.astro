---
import type { Moment } from "../data/moments";

interface Props extends Moment {
  index: number;
}

const { year, title, description, image, imageAlt, location, index } =
  Astro.props as Props;
const alt = imageAlt ?? title;
---

<figure
  class="moment-card group relative aspect-[4/3] h-full overflow-hidden rounded-2xl"
  data-index={index}
>
  {
    image ? (
      <button
        type="button"
        class="moment-open block h-full w-full cursor-zoom-in text-left"
        data-image={image}
        data-title={title}
        data-description={description}
        data-year={year}
        data-location={location ?? ""}
        data-alt={alt}
        aria-label={`Ampliar: ${title}`}
      >
        <img
          src={image}
          alt={alt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.05]"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"
          aria-hidden="true"
        />
        <div class="absolute inset-x-0 bottom-0 p-4">
          <h3 class="line-clamp-2 text-base leading-6 font-bold text-white text-balance">
            {title}
          </h3>
          {location && (
            <p class="mt-1.5 flex items-center gap-1.5 truncate text-xs font-medium text-white/85">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"
                />
                <circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
              <span class="truncate">{location}</span>
            </p>
          )}
        </div>
      </button>
    ) : (
      <div class="relative h-full w-full bg-gradient-to-br from-(--surface-soft) to-(--bg)">
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
          aria-hidden="true"
        />
        <div class="absolute inset-x-0 bottom-0 p-4">
          <p class="text-[11px] font-bold tracking-[0.14em] text-(--text-soft) uppercase">
            📷 photo coming soon
          </p>
          <h3 class="mt-1 line-clamp-2 text-base leading-6 font-bold text-balance">
            {title}
          </h3>
        </div>
      </div>
    )
  }
</figure>
