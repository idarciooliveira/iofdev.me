---
import { formatDate } from "../utils/posts";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  minutes?: number;
}

const { slug, title, description, pubDate, updatedDate, tags = [], minutes } = Astro.props;
---

<article class="card group transition-colors hover:border-(--accent)">
  <a href={`/posts/${slug}/`} class="block">
    <h3 class="text-xl font-semibold leading-tight sm:text-2xl group-hover:text-(--accent)">
      {title}
    </h3>
  </a>
  <p class="mt-3 text-base text-(--text-soft)">{description}</p>
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-(--text-soft)">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {updatedDate && updatedDate > pubDate && (
      <span>· Atualizado em {formatDate(updatedDate)}</span>
    )}
    {minutes && <span>· {minutes} min de leitura</span>}
    {tags.length > 0 && (
      <span class="inline-flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag.toLowerCase().replace(/[^a-z0-9]+/g, "-")}/`}
            class="badge transition-colors hover:border-(--accent) hover:text-(--accent)"
          >
            #{tag}
          </a>
        ))}
      </span>
    )}
  </div>
</article>
