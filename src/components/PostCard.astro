---
/**
 * Archive-style post item — AstroPaper archives pattern
 * (see clone/astro-paper/src/components/Card.astro + archives/index.astro).
 * Renders as <li>: linked title, datetime row with calendar icon
 * (date • reading time), then description. No box/border.
 */

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  minutes: number;
  heroImage?: string;
}

import { toTransitionName } from "../utils/transitionName";

const { slug, title, description, pubDate, minutes, heroImage } = Astro.props;

const tz = "Africa/Luanda";
const day = pubDate.toLocaleDateString("pt", { day: "numeric", timeZone: tz });
const mon = pubDate
  .toLocaleDateString("pt", { month: "short", timeZone: tz })
  .replace(/\./g, "");
const year = pubDate.toLocaleDateString("pt", {
  year: "numeric",
  timeZone: tz,
});
const dateLabel = `${day} ${mon}, ${year}`;
---

<li class="my-6">
  <a
    href={`/posts/${slug}/`}
    class="inline-block pb-1 text-lg font-medium text-(--post-title) decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
  >
    <span transition:name={toTransitionName(slug)} class="inline-block">
      {title}
    </span>
  </a>
  <div class="mt-2 flex items-center gap-x-2 text-(--text-soft)">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="inline-block size-5"
    >
      <path d="M8 2v4"></path>
      <path d="M16 2v4"></path>
      <rect width="18" height="18" x="3" y="4" rx="2"></rect>
      <path d="M3 10h18"></path>
    </svg>
    <time datetime={pubDate.toISOString()} class="text-sm italic">
      {dateLabel}
    </time>
    <span aria-hidden="true" class="text-sm italic">•</span>
    <span class="text-sm italic">{minutes} min de leitura</span>
  </div>
  {heroImage ? (
    <div class="mt-2 flex items-start gap-4">
      <a
        href={`/posts/${slug}/`}
        class="shrink-0"
        aria-hidden="true"
        tabindex="-1"
      >
        <img
          src={heroImage}
          alt=""
          loading="lazy"
          class="aspect-[4/3] w-36 rounded-md border border-(--border-soft) object-cover sm:w-44"
        />
      </a>
      <p class="text-(--text-soft)">{description}</p>
    </div>
  ) : (
    <p class="mt-2 text-(--text-soft)">{description}</p>
  )}
</li>
