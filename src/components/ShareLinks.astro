---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const links = [
  { name: "X", href: `https://x.com/share?url=${encodedUrl}&text=${encodedTitle}`, icon: "x" },
  { name: "Bluesky", href: `https://bsky.app/intent/compose?text=${encodedTitle}%20${encodedUrl}`, icon: "bluesky" },
  { name: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`, icon: "linkedin" },
  { name: "WhatsApp", href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`, icon: "whatsapp" },
  { name: "Facebook", href: `https://www.facebook.com/sharer.php?u=${encodedUrl}`, icon: "facebook" },
  { name: "Telegram", href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`, icon: "telegram" },
  { name: "Email", href: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`, icon: "mail" },
];
---

<div data-pagefind-ignore>
  <p class="post-footer__share-label">Share this post on:</p>
  <div class="post-footer__share-row">
    <div class="post-footer__share-icons">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.icon === "mail" ? undefined : "_blank"}
          rel={link.icon === "mail" ? undefined : "noopener noreferrer"}
          aria-label={`Share on ${link.name}`}
          title={link.name}
          class="icon-dock-btn"
        >
          {link.icon === "x" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg">
              <path
                fill="currentColor"
                d="M18.9 2H22l-6.77 7.74L23.2 22h-6.23l-4.88-6.38L6.5 22H3.34l7.24-8.28L2.8 2h6.39l4.41 5.83L18.9 2Zm-1.1 17.8h1.72L7.28 3.9H5.43l12.37 15.9Z"
              />
            </svg>
          )}
          {link.icon === "bluesky" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 10.8C10.4 8 7.2 6.1 4.6 5.5c-.4 2.4-.5 5 .3 7.3.7 2 2.2 3.4 3.2 4.6.4.5 1 .5 1.4 0 .4-.6 1-1.4 2.5-1.4s2.1.8 2.5 1.4c.4.5 1 .5 1.4 0 1-1.2 2.5-2.6 3.2-4.6.8-2.3.7-4.9.3-7.3-2.6.6-5.8 2.5-7.4 5.3Z" />
            </svg>
          )}
          {link.icon === "linkedin" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M8 11v5M8 8v.01M12 16v-3a2 2 0 0 1 4 0v3" />
            </svg>
          )}
          {link.icon === "whatsapp" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.4A8.5 8.5 0 1 1 21 11.5Z" />
              <path d="M9 9.5c.5 2.5 3 5 5.5 5.5l1-1.5 2 1c-.5 1.5-1.5 2-3 1.5-3-1-6-4-7-7-.5-1.5 0-2.5 1.5-3l1 2-1 1.5Z" />
            </svg>
          )}
          {link.icon === "facebook" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2Z" />
            </svg>
          )}
          {link.icon === "telegram" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="m22 2-7 20-4-9-9-4 20-7Z" />
              <path d="M22 2 11 13" />
            </svg>
          )}
          {link.icon === "mail" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-svg" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="14" x="3" y="5" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
        </a>
      ))}
    </div>
    <a href="#top" class="post-footer__top">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6" />
      </svg>
      Back to Top
    </a>
  </div>
</div>
