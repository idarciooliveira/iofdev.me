---
import { ui, type Lang } from "../i18n";

interface Props {
  prevUrl?: string;
  nextUrl?: string;
  currentPage: number;
  lastPage: number;
  lang?: Lang;
}

const { prevUrl, nextUrl, currentPage, lastPage, lang = "pt" } = Astro.props;
const t = ui[lang];
---

{lastPage > 1 && (
  <nav aria-label={t.paginationLabel} class="mt-10 flex items-center justify-between gap-4">
    {prevUrl ? (
      <a href={prevUrl} class="link-accent font-semibold" aria-label={t.prevPageLabel}>{t.prevPage}</a>
    ) : (
      <span aria-hidden="true" class="opacity-40">{t.prevPage}</span>
    )}
    <p class="text-sm text-(--text-soft)" aria-live="polite">
      {t.pageOf(currentPage, lastPage)}
    </p>
    {nextUrl ? (
      <a href={nextUrl} class="link-accent font-semibold" aria-label={t.nextPageLabel}>{t.nextPage}</a>
    ) : (
      <span aria-hidden="true" class="opacity-40">{t.nextPage}</span>
    )}
  </nav>
)}
