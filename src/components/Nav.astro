---
const { currentPath = "/" } = Astro.props;

const links = [
  { href: "/posts", label: "Posts" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Works" },
];

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="site-shell site-header__inner">
    <a href="/" class="logo-mark" aria-label="Home">
      IOFDev
    </a>

    <nav aria-label="Main navigation" class="hidden md:block">
      <ul class="flex items-center gap-8 lg:gap-10">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "nav-link",
                  isActive(link.href) && "nav-link--active",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                <span>{link.label}</span>
                <span class="nav-link__dot" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="nav-menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-(--text) transition hover:bg-(--surface-soft) md:hidden"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-icon-menu" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-6 w-6">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </span>

        <span class="nav-icon-close hidden" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-6 w-6">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </span>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-(--text) transition hover:bg-(--surface-soft)"
        aria-label="Alternar para modo escuro"
        aria-pressed="false"
      >
        <span class="theme-icon-light" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M12 3v2.4m0 13.2V21m9-9h-2.4M5.4 12H3m15.36 6.36-1.7-1.7M7.34 7.34l-1.7-1.7m12.72 0-1.7 1.7m-9.32 9.32-1.7 1.7M12 16.25A4.25 4.25 0 1 0 12 7.75a4.25 4.25 0 0 0 0 8.5Z"
            ></path>
          </svg>
        </span>

        <span class="theme-icon-dark" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-5 w-5">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              d="M20.2 14.4A8.5 8.5 0 1 1 9.6 3.8a7.2 7.2 0 0 0 10.6 10.6Z"
            ></path>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t md:hidden" style="border-color: var(--border-soft)">
    <nav aria-label="Navegação mobile" class="site-shell py-3">
      <ul class="flex flex-col gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "inline-flex w-full rounded-md px-3 py-2.5 text-base font-medium transition-colors",
                  isActive(link.href)
                    ? "bg-(--surface-soft) text-(--text)"
                    : "text-(--text-soft) hover:bg-(--surface-soft) hover:text-(--text)",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu only — theme toggle lives in src/scripts/theme.ts.
  // Re-initialized on astro:after-swap because ClientRouter swaps the
  // header DOM instead of doing a full page load (same pattern as
  // clone/astro-paper/src/components/Header.astro).
  const setMobileMenuState = (
    menuButton: HTMLElement,
    mobileMenu: HTMLElement,
    menuIcon: Element | null,
    closeIcon: Element | null,
    isOpen: boolean,
  ) => {
    menuButton.setAttribute("aria-expanded", String(isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen ? "Fechar menu de navegação" : "Abrir menu de navegação",
    );
    mobileMenu.classList.toggle("hidden", !isOpen);
    menuIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
  };

  const closeMobileMenu = () => {
    const menuButton = document.getElementById("nav-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!menuButton || !mobileMenu) return;
    setMobileMenuState(
      menuButton,
      mobileMenu,
      menuButton.querySelector(".nav-icon-menu"),
      menuButton.querySelector(".nav-icon-close"),
      false,
    );
  };

  const initMobileMenu = () => {
    const menuButton = document.getElementById("nav-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!menuButton || !mobileMenu) return;
    const menuIcon = menuButton.querySelector(".nav-icon-menu");
    const closeIcon = menuButton.querySelector(".nav-icon-close");

    setMobileMenuState(menuButton, mobileMenu, menuIcon, closeIcon, false);

    const boundButton = menuButton as HTMLButtonElement & {
      __menuBound?: boolean;
    };
    if (!boundButton.__menuBound) {
      boundButton.__menuBound = true;
      menuButton.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        setMobileMenuState(
          menuButton,
          mobileMenu,
          menuButton.querySelector(".nav-icon-menu"),
          menuButton.querySelector(".nav-icon-close"),
          !isOpen,
        );
      });

      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMobileMenu);
      });
    }

    // Document/window listeners are global — register once.
    const w = window as Window & { __navMenuGlobalBound?: boolean };
    if (!w.__navMenuGlobalBound) {
      w.__navMenuGlobalBound = true;
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMobileMenu();
        }
      });

      document.addEventListener("click", (event) => {
        const target = event.target as Node;
        const btn = document.getElementById("nav-menu-toggle");
        const menu = document.getElementById("mobile-menu");
        if (
          btn &&
          menu &&
          !btn.contains(target) &&
          !menu.contains(target)
        ) {
          closeMobileMenu();
        }
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
          closeMobileMenu();
        }
      });

      document.addEventListener("astro:after-swap", initMobileMenu);
    }
  };

  initMobileMenu();
</script>
