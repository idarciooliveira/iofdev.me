---
import MainLayout from "../layouts/main.astro";
import ShareLinks from "../components/ShareLinks.astro";
import ScrollProgressBar from "../components/ScrollProgressBar.astro";
import BackToTopButton from "../components/BackToTopButton.astro";
import { site } from "../config";
import { postUrl, tagsPath, ui, type Lang } from "../i18n";
import { formatDate, getReadingTime, getSlug, slugify, type BlogPost } from "../utils/posts";
import { toTransitionName } from "../utils/transitionName";
import { render } from "astro:content";

interface Props {
  lang: Lang;
  post: BlogPost;
  prev: BlogPost | null;
  next: BlogPost | null;
  translation: BlogPost | null;
}

const { lang, post, prev, next, translation } = Astro.props;
const t = ui[lang];
const { Content } = await render(post);
const slug = getSlug(post.id);
const { title, description, pubDate, updatedDate, tags, heroImage, canonicalURL, author } =
  post.data;

const pageOgImage = heroImage ?? site.ogImage;
const pagePath = postUrl(lang, slug);
const pageUrl = new URL(pagePath, Astro.site ?? site.url).toString();
const { text: readingText } = getReadingTime(post.body ?? "", lang);

const alternates = translation
  ? [
      { lang, href: pagePath },
      { lang: translation.data.lang, href: postUrl(translation.data.lang, getSlug(translation.id)) },
    ]
  : [];
const switchHref = alternates[1]?.href;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  inLanguage: lang,
  image: new URL(pageOgImage, Astro.site ?? site.url).toString(),
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: [{ "@type": "Person", name: author, url: site.profile }],
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
};
---

<MainLayout
  lang={lang}
  alternates={alternates}
  switchHref={switchHref}
  title={`${title} | ${site.title}`}
  description={description}
  ogImage={pageOgImage}
  canonicalURL={canonicalURL}
  ogType="article"
  pubDatetime={pubDate}
  modDatetime={updatedDate}
  schema={schema}
>
  <ScrollProgressBar />
  <div class="page-section" id="top">
    <div class="site-shell">
      <header>
        <h1
          style={{ viewTransitionName: toTransitionName(slug) }}
          class="block text-3xl font-bold tracking-tight text-(--post-title) sm:text-4xl"
        >
          {title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-(--text-soft)">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
          {updatedDate && updatedDate > pubDate && (
            <span>· {t.updatedOn} {formatDate(updatedDate, lang)}</span>
          )}
          <span>· {readingText}</span>
        </div>
      </header>

      {heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="mt-6 aspect-[21/9] w-full rounded-lg border border-(--border-soft) object-cover"
        />
      )}

      <article class="app-prose mt-8">
        <Content />
      </article>

      <footer class="mt-12">
        {tags.length > 0 && (
          <ul class="post-footer__tags" aria-label="Tags">
            {tags.map((tag: string) => (
              <li>
                <a href={`${tagsPath(lang)}/${slugify(tag)}/`} class="post-footer__tag">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )}

        <ShareLinks title={title} url={pageUrl} />
        <BackToTopButton />

        <hr class="post-footer__dotted" />

        <nav aria-label={t.postsAdjacent} class="flex items-start justify-between gap-4" data-pagefind-ignore>
          {prev ? (
            <a href={postUrl(prev.data.lang, getSlug(prev.id))} class="post-footer__next !text-left">
              <span class="post-footer__next-kicker !justify-start">{t.previousPost}</span>
              <p class="post-footer__next-title">{prev.data.title}</p>
            </a>
          ) : <span />}
          {next ? (
            <a href={postUrl(next.data.lang, getSlug(next.id))} class="post-footer__next ml-auto">
              <span class="post-footer__next-kicker">{t.nextPost}
                <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </span>
              <p class="post-footer__next-title">{next.data.title}</p>
            </a>
          ) : <span />}
        </nav>
      </footer>
    </div>
  </div>
</MainLayout>
