---
import MainLayout from "../layouts/main.astro";
import Section from "../components/Section.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { site } from "../config";
import { langInfo, ui, type Lang } from "../i18n";
import { getReadingTime, getSlug } from "../utils/posts";
import type { Page } from "astro";

interface Props {
  lang: Lang;
  page: Page;
}

const { lang, page } = Astro.props;
const t = ui[lang];
const pageTitle = `${t.postsPageTitle(page.currentPage)} — ${site.title}`;

// Archives-style grouping: year (desc) → month (desc) → posts (newest first).
type Post = (typeof page.data)[number];
const postsByYear = new Map<number, Post[]>();
for (const post of page.data as Post[]) {
  const year = new Date(post.data.pubDate).getFullYear();
  const group = postsByYear.get(year) ?? [];
  group.push(post);
  postsByYear.set(year, group);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);

const monthFormatter = new Intl.DateTimeFormat(langInfo[lang].dateLocale, { month: "long" });
const monthName = (monthIndex: number) => {
  const name = monthFormatter.format(new Date(2000, monthIndex, 1));
  return name.charAt(0).toUpperCase() + name.slice(1);
};
---

<MainLayout
  title={pageTitle}
  description={t.postsDescription}
  ogImage={site.ogImage}
  lang={lang}
>
  <Section title={t.postsSectionTitle} description={t.postsSectionDescription}>
    <h1 class="sr-only">{t.postsH1}</h1>

    {years.length === 0 && <p class="text-(--text-soft)">{t.emptyPosts}</p>}

    {years.map((year) => {
      const yearPosts = postsByYear.get(year)!;
      const postsByMonth = new Map<number, Post[]>();
      for (const post of yearPosts) {
        const month = new Date(post.data.pubDate).getMonth();
        const group = postsByMonth.get(month) ?? [];
        group.push(post);
        postsByMonth.set(month, group);
      }
      const months = [...postsByMonth.keys()].sort((a, b) => b - a);
      return (
        <section aria-label={t.postsOfYear(year)} class="mb-10 last:mb-0">
          <span class="text-2xl font-bold tracking-tight">{year}</span>
          <sup class="ml-1 text-sm text-(--text-soft)">{yearPosts.length}</sup>
          <div aria-hidden="true" class="mt-2 h-px bg-(--accent)" />
          {months.map((month) => {
            const monthPosts = postsByMonth.get(month)!;
            return (
              <div class="mt-8">
                <div class="text-xl">
                  <span class="font-bold">{monthName(month)}</span>
                  <sup class="ml-1 text-xs text-(--text-soft)">{monthPosts.length}</sup>
                </div>
                <ul>
                  {monthPosts.map((post) => {
                    const { minutes } = getReadingTime(post.body ?? "", post.data.lang);
                    return (
                      <PostCard
                        slug={getSlug(post.id)}
                        title={post.data.title}
                        description={post.data.description}
                        pubDate={post.data.pubDate}
                        minutes={minutes}
                        heroImage={post.data.heroImage}
                        lang={post.data.lang}
                      />
                    );
                  })}
                </ul>
              </div>
            );
          })}
        </section>
      );
    })}

    <Pagination
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      lang={lang}
    />
  </Section>
</MainLayout>
